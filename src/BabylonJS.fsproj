<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BabylonJS</AssemblyName>
    <RootNamespace>BabylonJS</RootNamespace>
    <WebSharperSourceMap>false</WebSharperSourceMap>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Client.fs" />
    <None Include="package.json" />
    <None Include="esbuild.config.mjs" />
    <None Include="wsconfig.json" />
    <Content Include="index.html" />
    <Content Include="site.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WebSharper" Version="10.1.10.687" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.10.687" />
    <PackageReference Include="WebSharper.UI" Version="10.1.8.687" />
    <PackageReference Include="WebSharper.BabylonJs" Version="10.1.0.744" />
  </ItemGroup>

  <Target Name="ESBuildBundle" AfterTargets="WebSharperCompile" Condition=" '$(Configuration)' == 'Release' ">
    <Exec Command="npm install" />
    <Exec Command="node ./esbuild.config.mjs" />
  </Target>

</Project>